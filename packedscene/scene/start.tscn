# 该节点已在场景中实例化并加入到场景的节点树

func _ready() # 所有节点准备就绪后触发1次函数

func _physics_process(delta) # 主循环(物理时间帧)
func _process(delta) # 主循环(时间帧)

func _exit_tree() # 此节点退出场景时触发1次函数
