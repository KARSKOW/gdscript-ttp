[node name="RichTextLabel" type="RichTextLabel" parent="VBoxContainer/ScrollContainer/VBoxContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "既然你决定使用这个软件, 那么我就要提问以下简单的问题:
-> 你的需求是什么？
-> 你有没有明确自己要实现的功能和目标？
-> 你具体要做的是哪个项目？
如果要学习：
那么最好给自己设立一个目标要做什么, 然后决定是否要继续。
我开发这个软件的目的是存储我学到的知识, 
以简单易懂的方式呈现给大家。
至于要拿这段代码怎么变通，由你们自由发挥。
教程会在此处展示, 尽量做到易懂易编。
"
fit_content = true
vertical_alignment = 1

